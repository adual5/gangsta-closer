{
  "manifest_version": 3,
  "name": "Gangsta Closer",
  "version": "1.1.0",
  "description": "Plays a sound clip of your choice when you close an issue or PR in GitHub, Linear, or Jira.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "src/popup/popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "offscreen"],
  "content_scripts": [
    { "matches": ["https://github.com/*"], "js": ["src/content/engine.js", "src/content/github.js"], "run_at": "document_idle" },
    { "matches": ["https://linear.app/*"], "js": ["src/content/engine.js", "src/content/linear.js"], "run_at": "document_idle" },
    { "matches": ["https://*.atlassian.net/*"], "js": ["src/content/engine.js", "src/content/jira.js"], "run_at": "document_idle" }
  ]
}
